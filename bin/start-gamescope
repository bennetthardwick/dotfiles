#!/usr/bin/env bash

usage() {
	cat <<EOF
Usage: $(basename "$0") [options]

Options:
  --remote-play         Start Sunshine (KMS) at 2560x1440
  --lowres              1920x1080 nested resolution
  --output CONNECTOR    DRM output (default: DP-1)
  -h, --help            Show this help
EOF
}

REMOTE_PLAY=false
LOWRES=false
OUTPUT=DP-1

while [[ $# -gt 0 ]]; do
	case $1 in
	--remote-play)
		REMOTE_PLAY=true
		shift
		;;
	--lowres)
		LOWRES=true
		shift
		;;
	--output)
		if [[ -z "${2:-}" || "$2" == -* ]]; then
			echo "--output requires a connector name (e.g. DP-1)" >&2
			exit 1
		fi
		OUTPUT="$2"
		shift 2
		;;
	--output=*)
		OUTPUT="${1#*=}"
		if [[ -z "$OUTPUT" ]]; then
			echo "--output requires a connector name (e.g. DP-1)" >&2
			exit 1
		fi
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	-*)
		echo "Unknown option $1" >&2
		exit 1
		;;
	*)
		echo "Unexpected argument $1" >&2
		exit 1
		;;
	esac
done

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export PATH="$HOME/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

for proc in steam gamescope sunshine; do
	killall -u "$(id -un)" "$proc" 2>/dev/null || true
done
rm -f "${XDG_RUNTIME_DIR}/gamescope-"*.lock "${XDG_RUNTIME_DIR}"/gamescope-*

WIDTH=3840
HEIGHT=2160
OUTPUT_WIDTH=3840
OUTPUT_HEIGHT=2160
STEAM_COMMAND="steam -dev steam://open/bigpicture"

if [[ "$REMOTE_PLAY" == true ]]; then
	WIDTH=2560
	HEIGHT=1440
	OUTPUT_WIDTH=2560
	OUTPUT_HEIGHT=1440
fi

if [[ "$LOWRES" == true ]]; then
	WIDTH=1920
	HEIGHT=1080
fi

SUNSHINE_PID=""
if [[ "$REMOTE_PLAY" == true ]]; then
	WAYLAND_DISPLAY= DISPLAY= sunshine capture=kms &
	SUNSHINE_PID=$!
fi

CURRENT_TTY="$(tty 2>/dev/null || true)"

if [[ "$CURRENT_TTY" == /dev/tty* || -z "${WAYLAND_DISPLAY:-}" ]]; then
	# DRM seat binds to the foreground VT. Default tty3 so tty1 stays a login.
	vt="${GAMESCOPE_VT:-3}"
	if [[ "$CURRENT_TTY" != "/dev/tty${vt}" ]]; then
		sudo chvt "$vt" || true
	fi
	unset WAYLAND_DISPLAY DISPLAY
	GAMESCOPE_ARGS=(
		--backend drm
		-w "$WIDTH" -h "$HEIGHT" -W "$OUTPUT_WIDTH" -H "$OUTPUT_HEIGHT"
		-r 60 --rt --xwayland-count 2
		-F fsr -e
		-O "$OUTPUT"
	)
else
	GAMESCOPE_ARGS=(
		--mangoapp --rt
		-w "$WIDTH" -h "$HEIGHT"
		-r 60 -f
	)
fi

gamescope "${GAMESCOPE_ARGS[@]}" -- $STEAM_COMMAND

if [[ -n "$SUNSHINE_PID" ]]; then
	kill "$SUNSHINE_PID" 2>/dev/null || true
fi
