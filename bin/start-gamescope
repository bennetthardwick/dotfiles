#!/usr/bin/env bash

LOG=/tmp/start-gamescope.log

usage() {
	cat <<EOF
Usage: $(basename "$0") [options]

Options:
  --remote-play    Start Sunshine and use 2560x1440
  --lowres         Use 1920x1080 nested resolution
  --no-reexec      Don't re-launch on a VT (used when started from SSH)
  -h, --help       Show this help
EOF
}

ORIGINAL_ARGS=("$@")
REMOTE_PLAY=false
LOWRES=false
NO_REEXEC=false

while [[ $# -gt 0 ]]; do
	case $1 in
	--remote-play)
		REMOTE_PLAY=true
		shift
		;;
	--lowres)
		LOWRES=true
		shift
		;;
	--no-reexec)
		NO_REEXEC=true
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	-*)
		echo "Unknown option $1" >&2
		exit 1
		;;
	*)
		echo "Unexpected argument $1" >&2
		exit 1
		;;
	esac
done

CURRENT_TTY="$(tty 2>/dev/null || true)"
IS_SSH=false
if [[ -n "${SSH_CONNECTION:-}" || -n "${SSH_CLIENT:-}" || -n "${SSH_TTY:-}" ]]; then
	IS_SSH=true
fi

# SSH sessions are pts devices, so re-exec on a real VT for DRM.
if [[ "$NO_REEXEC" != true && "$IS_SSH" == true && "$CURRENT_TTY" != /dev/tty* ]]; then
	self="$(readlink -f "${BASH_SOURCE[0]}")"
	echo "SSH session detected; re-launching on a free VT via openvt"
	echo "logs: $LOG"

	exec sudo openvt -s -w -- \
		sudo -u "$USER" \
		--preserve-env=HOME,PATH,USER,LOGNAME,XDG_RUNTIME_DIR,DBUS_SESSION_BUS_ADDRESS \
		-- "$self" --no-reexec "${ORIGINAL_ARGS[@]}"
fi

if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
	export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

export PATH="$HOME/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

exec > >(tee -a "$LOG") 2>&1
echo "==== $(date) ===="
echo "user=$(id -un) uid=$(id -u) tty=$CURRENT_TTY"
echo "PATH=$PATH"
echo "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"

connected_outputs() {
	local status conn
	for status in /sys/class/drm/card*-*/status; do
		[[ -e "$status" ]] || continue
		[[ "$(<"$status")" == connected ]] || continue
		conn="$(basename "$(dirname "$status")")"
		printf '%s\n' "${conn#*-}"
	done
}

while pgrep -u "$(id -un)" -x steam >/dev/null; do
	killall -u "$(id -un)" steam 2>/dev/null || true
	sleep 0.2
done

WIDTH=3840
HEIGHT=2160

OUTPUT_WIDTH=3840
OUTPUT_HEIGHT=2160

STEAM_COMMAND="steam -dev steam://open/bigpicture"

if [[ "$REMOTE_PLAY" == true ]]; then
	if ! pgrep -u "$(id -un)" -x sunshine >/dev/null; then
		sunshine &
		sleep 5
	fi

	WIDTH=2560
	HEIGHT=1440
	OUTPUT_WIDTH=2560
	OUTPUT_HEIGHT=1440
fi

if [[ "$LOWRES" == true ]]; then
	WIDTH=1920
	HEIGHT=1080
fi

if ! command -v gamescope >/dev/null; then
	echo "gamescope not found in PATH=$PATH" >&2
	exit 1
fi

GAMESCOPE_ARGS=()

if [[ "$NO_REEXEC" == true || "$CURRENT_TTY" == /dev/tty* ]]; then
	GAMESCOPE_ARGS+=(
		--backend drm
		-w "$WIDTH" -h "$HEIGHT" -W "$OUTPUT_WIDTH" -H "$OUTPUT_HEIGHT"
		-r 60 --rt --xwayland-count 2
		-F fsr -e
	)

	outputs="$(connected_outputs | paste -sd, -)"
	echo "connected outputs: ${outputs:-none}"
	if [[ -n "$outputs" ]]; then
		GAMESCOPE_ARGS+=(-O "$outputs")
	fi
else
	GAMESCOPE_ARGS+=(
		--mangoapp --rt
		-w "$WIDTH" -h "$HEIGHT"
		-r 60 -f
	)
fi

echo "running: gamescope ${GAMESCOPE_ARGS[*]} -- $STEAM_COMMAND"

gamescope "${GAMESCOPE_ARGS[@]}" -- $STEAM_COMMAND
echo "gamescope exited with $?"
