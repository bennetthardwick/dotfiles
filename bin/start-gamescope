#!/usr/bin/env bash

LOG=/tmp/start-gamescope.log

usage() {
	cat <<EOF
Usage: $(basename "$0") [options]

Options:
  --remote-play    Start Sunshine and use 2560x1440
  --lowres         Use 1920x1080 nested resolution
  --no-reexec      Don't re-launch on a VT (used when started from SSH)
  -h, --help       Show this help
EOF
}

ORIGINAL_ARGS=("$@")
REMOTE_PLAY=false
LOWRES=false
NO_REEXEC=false

while [[ $# -gt 0 ]]; do
	case $1 in
	--remote-play)
		REMOTE_PLAY=true
		shift
		;;
	--lowres)
		LOWRES=true
		shift
		;;
	--no-reexec)
		NO_REEXEC=true
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	-*)
		echo "Unknown option $1" >&2
		exit 1
		;;
	*)
		echo "Unexpected argument $1" >&2
		exit 1
		;;
	esac
done

CURRENT_TTY="$(tty 2>/dev/null || true)"
IS_SSH=false
if [[ -n "${SSH_CONNECTION:-}" || -n "${SSH_CLIENT:-}" || -n "${SSH_TTY:-}" ]]; then
	IS_SSH=true
fi

# SSH sessions are pts devices, so re-exec on a real VT for DRM.
if [[ "$NO_REEXEC" != true && "$IS_SSH" == true && "$CURRENT_TTY" != /dev/tty* ]]; then
	self="$(readlink -f "${BASH_SOURCE[0]}")"
	uid="$(id -u)"
	gid="$(id -g)"
	runtime="${XDG_RUNTIME_DIR:-/run/user/$uid}"

	echo "SSH session detected; re-launching on a free VT via openvt" | tee -a "$LOG"
	echo "logs: $LOG"

	# Nested sudo uses a pty (use_pty), so gamescope would not own the VT.
	# Drop privileges with setpriv instead so stdin stays /dev/ttyN.
	sudo openvt -v -s -w -- \
		/usr/bin/env \
		HOME="$HOME" \
		USER="$USER" \
		LOGNAME="${LOGNAME:-$USER}" \
		PATH="$HOME/bin:/usr/local/bin:/usr/bin:/bin" \
		XDG_RUNTIME_DIR="$runtime" \
		XDG_SESSION_TYPE=tty \
		DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$runtime/bus}" \
		/usr/bin/setpriv --reuid="$uid" --regid="$gid" --init-groups -- \
		"$self" --no-reexec "${ORIGINAL_ARGS[@]}"
	echo "openvt exited $?" | tee -a "$LOG"
	exit $?
fi

if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
	export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

export PATH="$HOME/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

exec > >(tee -a "$LOG") 2>&1
echo "==== $(date) ===="
echo "user=$(id -un) uid=$(id -u) tty=$CURRENT_TTY vt=$(cat /sys/class/tty/tty0/active 2>/dev/null || true)"
echo "PATH=$PATH"
echo "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"

connected_outputs() {
	local status conn
	for status in /sys/class/drm/card*-*/status; do
		[[ -e "$status" ]] || continue
		[[ "$(<"$status")" == connected ]] || continue
		conn="$(basename "$(dirname "$status")")"
		printf '%s\n' "${conn#*-}"
	done
}

while pgrep -u "$(id -un)" -x steam >/dev/null; do
	killall -u "$(id -un)" steam 2>/dev/null || true
	sleep 0.2
done

WIDTH=3840
HEIGHT=2160

OUTPUT_WIDTH=3840
OUTPUT_HEIGHT=2160

STEAM_COMMAND="steam -dev steam://open/bigpicture"

SUNSHINE_PID=""
if [[ "$REMOTE_PLAY" == true ]]; then
	WIDTH=2560
	HEIGHT=1440
	OUTPUT_WIDTH=2560
	OUTPUT_HEIGHT=1440

	if ! pgrep -u "$(id -un)" -x sunshine >/dev/null; then
		# KMS capture needs gamescope (or a powered-on display) first.
		(
			for _ in $(seq 1 30); do
				pgrep -u "$(id -un)" -x gamescope >/dev/null && break
				sleep 1
			done
			sleep 2
			exec sunshine
		) &
		SUNSHINE_PID=$!
	fi
fi

if [[ "$LOWRES" == true ]]; then
	WIDTH=1920
	HEIGHT=1080
fi

if ! command -v gamescope >/dev/null; then
	echo "gamescope not found in PATH=$PATH" >&2
	exit 1
fi

GAMESCOPE_ARGS=()

if [[ "$NO_REEXEC" == true || "$CURRENT_TTY" == /dev/tty* ]]; then
	GAMESCOPE_ARGS+=(
		--backend drm
		-w "$WIDTH" -h "$HEIGHT" -W "$OUTPUT_WIDTH" -H "$OUTPUT_HEIGHT"
		-r 60 --rt --xwayland-count 2
		-F fsr -e
	)

	outputs="$(connected_outputs | paste -sd, -)"
	echo "connected outputs: ${outputs:-none}"
	if [[ -n "$outputs" ]]; then
		GAMESCOPE_ARGS+=(-O "$outputs")
	fi
else
	GAMESCOPE_ARGS+=(
		--mangoapp --rt
		-w "$WIDTH" -h "$HEIGHT"
		-r 60 -f
	)
fi

echo "running: gamescope ${GAMESCOPE_ARGS[*]} -- $STEAM_COMMAND"

gamescope "${GAMESCOPE_ARGS[@]}" -- $STEAM_COMMAND
echo "gamescope exited with $?"

if [[ -n "$SUNSHINE_PID" ]]; then
	kill "$SUNSHINE_PID" 2>/dev/null || true
fi
