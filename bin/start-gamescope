#!/usr/bin/env bash

LOG=/tmp/start-gamescope.log

usage() {
	cat <<EOF
Usage: $(basename "$0") [options]

Options:
  --remote-play    Start Sunshine and use 2560x1440
  --lowres         Use 1920x1080 nested resolution
  --no-reexec      Ignored (openvt re-exec was removed)
  -h, --help       Show this help
EOF
}

REMOTE_PLAY=false
LOWRES=false

while [[ $# -gt 0 ]]; do
	case $1 in
	--remote-play)
		REMOTE_PLAY=true
		shift
		;;
	--lowres)
		LOWRES=true
		shift
		;;
	--no-reexec)
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	-*)
		echo "Unknown option $1" >&2
		exit 1
		;;
	*)
		echo "Unexpected argument $1" >&2
		exit 1
		;;
	esac
done

CURRENT_TTY="$(tty 2>/dev/null || true)"

if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
	export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

export PATH="$HOME/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

exec > >(tee -a "$LOG") 2>&1
echo "==== $(date) ===="
echo "user=$(id -un) uid=$(id -u) tty=$CURRENT_TTY vt=$(cat /sys/class/tty/tty0/active 2>/dev/null || true)"
echo "PATH=$PATH"
echo "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
echo "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}"
echo "DISPLAY=${DISPLAY:-}"

connected_outputs() {
	local status conn
	for status in /sys/class/drm/card*-*/status; do
		[[ -e "$status" ]] || continue
		[[ "$(<"$status")" == connected ]] || continue
		conn="$(basename "$(dirname "$status")")"
		printf '%s\n' "${conn#*-}"
	done
}

# Leftover DRM gamescope holds the lockfile and pauses the next seat.
for proc in steam gamescope sunshine; do
	while pgrep -u "$(id -un)" -x "$proc" >/dev/null; do
		killall -u "$(id -un)" "$proc" 2>/dev/null || true
		sleep 0.2
	done
done
rm -f "${XDG_RUNTIME_DIR}/gamescope-"*.lock "${XDG_RUNTIME_DIR}"/gamescope-*

WIDTH=3840
HEIGHT=2160
OUTPUT_WIDTH=3840
OUTPUT_HEIGHT=2160
STEAM_COMMAND="steam -dev steam://open/bigpicture"

SUNSHINE_PID=""
if [[ "$REMOTE_PLAY" == true ]]; then
	WIDTH=2560
	HEIGHT=1440
	OUTPUT_WIDTH=2560
	OUTPUT_HEIGHT=1440

	# Sibling process: does not inherit gamescope's WAYLAND_DISPLAY.
	# 2026 Sunshine drops CAP_SYS_ADMIN, so KMS cannot open card1 while
	# gamescope is DRM master. Capture the compositor via wlr-screencopy.
	(
		socket="${XDG_RUNTIME_DIR}/gamescope-0"
		# -S is true for a leftover socket file that nothing is listening on.
		for _ in $(seq 1 60); do
			if [[ -S "$socket" ]] && python3 -c "import socket; s=socket.socket(socket.AF_UNIX); s.settimeout(1); s.connect('$socket')" 2>/dev/null; then
				break
			fi
			sleep 0.5
		done
		export WAYLAND_DISPLAY=gamescope-0
		export DISPLAY=:0
		unset SSH_CONNECTION SSH_CLIENT SSH_TTY
		exec sunshine capture=wlr
	) &
	SUNSHINE_PID=$!
fi

if [[ "$LOWRES" == true ]]; then
	WIDTH=1920
	HEIGHT=1080
fi

if ! command -v gamescope >/dev/null; then
	echo "gamescope not found in PATH=$PATH" >&2
	exit 1
fi

# Nested mangoapp only inside an existing Wayland session. SSH / TTY / no
# compositor: DRM via seatd. openvt is not required for that.
USE_DRM=false
if [[ "$CURRENT_TTY" == /dev/tty* || -z "${WAYLAND_DISPLAY:-}" ]]; then
	USE_DRM=true
fi

GAMESCOPE_ARGS=()
if [[ "$USE_DRM" == true ]]; then
	# ssh -X would otherwise make gamescope try to nest on the forwarded DISPLAY.
	unset WAYLAND_DISPLAY DISPLAY

	GAMESCOPE_ARGS+=(
		--backend drm
		-w "$WIDTH" -h "$HEIGHT" -W "$OUTPUT_WIDTH" -H "$OUTPUT_HEIGHT"
		-r 60 --rt --xwayland-count 2
		-F fsr -e
	)

	outputs="$(connected_outputs | paste -sd, -)"
	echo "connected outputs: ${outputs:-none}"
	if [[ -n "$outputs" ]]; then
		GAMESCOPE_ARGS+=(-O "$outputs")
	fi
else
	GAMESCOPE_ARGS+=(
		--mangoapp --rt
		-w "$WIDTH" -h "$HEIGHT"
		-r 60 -f
	)
fi

echo "running: gamescope ${GAMESCOPE_ARGS[*]} -- $STEAM_COMMAND"

gamescope "${GAMESCOPE_ARGS[@]}" -- $STEAM_COMMAND
echo "gamescope exited with $?"

if [[ -n "$SUNSHINE_PID" ]]; then
	kill "$SUNSHINE_PID" 2>/dev/null || true
fi
