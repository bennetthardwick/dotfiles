#!/usr/bin/env bash

set -e

usage() {
    echo "usage: convert-video <input> <output> <?bitrate>"
    exit 1
}

if [ -z "$1" ]; then
    usage
fi

if [ -z "$2" ]; then
    usage
fi

input="$1"
output="$2"

# Check if the filename (ignoring directories) has an extension
if [[ "$(basename "$output")" != *.* ]]; then
    output="${output}.mp4"
fi

bitrate="${3:-"3000k"}"

# Create a secure temporary directory
TMP_DIR=$(mktemp -d)

# Set a trap to ensure the directory is deleted on script exit (success, failure, or cancellation)
trap 'rm -rf "$TMP_DIR"' EXIT

log_prefix="$TMP_DIR/passlog"

ffmpeg -y -i "$input" \
    -preset slow \
    -tune film \
    -c:v libx264 \
    -b:v "$bitrate" \
    -pass 1 \
    -passlogfile "$log_prefix" \
    -an \
    -f null \
    /dev/null

ffmpeg \
    -i "$input" \
    -preset slow \
    -tune film \
    -c:v libx264 \
    -b:v "$bitrate" \
    -pass 2 \
    -passlogfile "$log_prefix" \
    -c:a aac \
    -b:a 128k \
    -af "loudnorm=I=-16:TP=-1.5:LRA=11" \
    "$output"
